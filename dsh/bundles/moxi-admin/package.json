{
  "name": "moxi-admin-bundle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "墨戏生花 · 管理后台（DSH 客户端插件）：工作台 KPI / 项目 / 规则与技能 / 模型与用量 / 日志与导入导出",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar"]
    },
    "compatibility": { "dshReleases": { "0.2.1-rc.5+": "compatible" } }
  }
}
